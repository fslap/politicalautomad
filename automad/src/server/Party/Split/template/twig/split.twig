<div class="wp-block-group {{ classes }}">
    {% if section_id %}<a id="{{ section_id }}"></a>{% endif %}

    {% if title %}<h1 class="wp-block-heading section-heading">{{ title }}</h1>{% endif %}

    {% if desktop_image %}
        <img src="{{ desktop_image }}" class="section-image{% if mobile_image %} desktop-image-1000{% endif %}" alt="{{ title }}">
    {% endif %}
    {% if mobile_image %}
        <img src="{{ mobile_image }}" class="section-image mobile-image-1000" alt="{{ title }}">
    {% endif %}

    {% if has_inner_container %}<div class="inner-container">{% endif %}

    <div class="split-container {{ container_classes }}" style="{{ container_style }}">
        {% for pane in panes %}
            <div class="split-pane {{ pane.position }}{% if pane.is_auto %} split-pane--auto{% endif %} {{ pane.classes }}" style="{{ pane.style }}">
                {% if pane.title %}<h3 class="wp-block-heading split-pane__title">{{ pane.title }}</h3>{% endif %}
                {% if pane.is_leaflet %}
                    <div class="leaflet-map" style="height: {{ pane.map_height }};" data-party-map="{{ pane.map_json }}"></div>
                {% elseif pane.is_image and pane.image %}
                    <img src="{{ pane.image }}" class="split-image" alt="{{ pane.image_alt }}" loading="lazy">
                {% elseif pane.is_markdown %}
                    <div class="markdown-content">{{ pane.html_content|raw }}</div>
                {% elseif pane.is_html %}
                    <div class="split-pane__html">{{ pane.html|raw }}</div>
                {% elseif pane.is_video and pane.video_embed %}
                    <div class="split-pane__video">
                        <iframe src="{{ pane.video_embed }}" title="{{ pane.title }}" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    {% if has_inner_container %}</div>{% endif %}
</div>
