<div class="wp-block-group {{classes}}">
    {{#section_id}}<a id="{{section_id}}"></a>{{/section_id}}

    {{#title}}<h1 class="wp-block-heading section-heading">{{title}}</h1>{{/title}}

    {{#desktop_image}}
        <img src="{{desktop_image}}" class="section-image{{#mobile_image}} desktop-image-1000{{/mobile_image}}" alt="{{title}}">
    {{/desktop_image}}
    {{#mobile_image}}
        <img src="{{mobile_image}}" class="section-image mobile-image-1000" alt="{{title}}">
    {{/mobile_image}}

    {{#has_inner_container}}<div class="inner-container">{{/has_inner_container}}

    <div class="split-container {{container_classes}}" style="{{container_style}}">
        {{#panes}}
            <div class="split-pane {{position}}{{#is_auto}} split-pane--auto{{/is_auto}} {{classes}}" style="{{style}}">
                {{#title}}<h3 class="wp-block-heading split-pane__title">{{title}}</h3>{{/title}}
                {{#is_leaflet}}
                    <div class="leaflet-map" style="height: {{map_height}};" data-party-map="{{map_json}}"></div>
                {{/is_leaflet}}
                {{#is_image}}
                    {{#image}}<img src="{{image}}" class="split-image" alt="{{image_alt}}" loading="lazy">{{/image}}
                {{/is_image}}
                {{#is_markdown}}
                    <div class="markdown-content">{{{html_content}}}</div>
                {{/is_markdown}}
                {{#is_html}}
                    <div class="split-pane__html">{{{html}}}</div>
                {{/is_html}}
                {{#is_video}}
                    {{#video_embed}}
                        <div class="split-pane__video">
                            <iframe src="{{video_embed}}" title="{{title}}" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
                        </div>
                    {{/video_embed}}
                {{/is_video}}
            </div>
        {{/panes}}
    </div>

    {{#has_inner_container}}</div>{{/has_inner_container}}
</div>
