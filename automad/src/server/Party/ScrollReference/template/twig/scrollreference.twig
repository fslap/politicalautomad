<div class="wp-block-group scroll-reference {{ classes }}">
  {% if section_id %}<a id="{{ section_id }}"></a>{% endif %}
  {% if headline %}<h1 class="wp-block-heading section-heading">{{ headline }}</h1>{% endif %}

  {% if has_inner_container %}<div class="inner-container">{% endif %}

  <div class="scroll scroll-reference__scroller">
    <div class="scroll-content">
      {% for item in items %}
        <div class="block scroll-reference__card">
          {% if item.id %}<a id="{{ item.id }}"></a>{% endif %}
          {% if item.subject %}<h6 class="wp-block-heading">{{ item.subject }}</h6>{% endif %}
          {% if item.text %}<p class="wp-block-paragraph">{{ item.text }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  {% if has_inner_container %}</div>{% endif %}
</div>
