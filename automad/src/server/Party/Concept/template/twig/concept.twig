<div class="wp-block-group widthcontainer {{ classes }}">
    <a id="{{ section_id }}"></a>

    <div class="split-container">
        <div class="split-left">
            <div class="split-image-container">
                {% if desktop_image %}
                    <img class="split-image desktop-image-1000" src="{{ desktop_image }}" alt="{{ title }}">
                {% endif %}
                {% if mobile_image %}
                    <img class="split-image mobile-image-1000" src="{{ mobile_image }}" alt="{{ title }}">
                {% endif %}
            </div>
        </div>

        <div class="split-right">
            <h1 class="wp-block-heading">{{ title }}</h1>
            <br>
            <h2 class="wp-block-heading bgwhite"><b>{{ subtitle }}</b></h2>
            <br>
            <h2 class="wp-block-heading"><i>{{ subtitle_emphasis }}</i></h2>
            <br>

            {% for feature in features %}
                <h4 class="wp-block-heading">{{ feature_prefix }} {{ feature }}</h4>
            {% endfor %}
        </div>
    </div>
</div>