<section class="{{slide_classes}}" data-party-slide data-slide-title="{{slide_title}}">
    {{{slide_top}}}
    <div class="party-slide__body">
        <div class="party-slide__hero">{{{hero_html}}}</div>
        <div class="party-slide__scene party-slide__scene--first">
            {{#scene_image}}<img src="{{scene_image}}" alt="" decoding="async">{{/scene_image}}
            <div class="party-slide__houses">{{{houses_html}}}</div>
            <div class="party-slide__waves">{{{wave_html}}}</div>
        </div>
    </div>
    {{{slide_bottom}}}
</section>
