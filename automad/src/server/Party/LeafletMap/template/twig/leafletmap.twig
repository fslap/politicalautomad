<div class="wp-block-group {{ classes }}">
    {% if section_id %}<a id="{{ section_id }}"></a>{% endif %}
    {% if title %}<h1 class="wp-block-heading section-heading">{{ title }}</h1>{% endif %}

    {% if has_inner_container %}<div class="inner-container">{% endif %}

    <div id="{{ section_id }}_map" class="leaflet-map" style="height: {{ map_height }};" data-party-map="{{ map_json }}"></div>

    {% if has_inner_container %}</div>{% endif %}
</div>
