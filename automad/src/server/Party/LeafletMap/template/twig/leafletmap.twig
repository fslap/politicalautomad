<div class="wp-block-group {{ classes }}">
    <a id="{{ section_id }}"></a>
    
    <h1 class="wp-block-heading">{{ title }}</h1>
    
    {% if has_inner_container %}
        <div class="inner-container">
    {% endif %}
    
    <div id="{{ section_id }}_map" class="leaflet-map" style="height: {{ map_height }};"></div>
    
    {% if has_inner_container %}
        </div>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var map = L.map('{{ section_id }}_map').setView([{{ map_center }}], {{ map_zoom }});
    
    L.tileLayer('{{ tile_url }}', {
        maxZoom: 18,
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    {% if markers %}
        {% for marker in markers %}
            L.marker([{{ marker.lat }}, {{ marker.lng }}])
                .addTo(map)
                {% if marker.popup %}
                    .bindPopup('{{ marker.popup|e('js') }}')
                {% endif %};
        {% endfor %}
    {% endif %}
    
    {% if geojson_content %}
    var geojsonFeature = {{ geojson_content|raw }};
    
    L.geoJSON(geojsonFeature, {
        onEachFeature: function (feature, layer) {
            if (feature.properties && feature.properties.name) {
                var popupContent = '<h4>' + feature.properties.name + '</h4>';
                if (feature.properties.description) {
                    popupContent += '<p>' + feature.properties.description + '</p>';
                }
                layer.bindPopup(popupContent);
            }
        }
    }).addTo(map);
    {% endif %}
});
</script>