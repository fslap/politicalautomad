<div class="wp-block-group widthcontainer music-player {{ classes }}" data-party-music-player>
    {% if title %}<h1 class="wp-block-heading">{{ title }}</h1>{% endif %}

    <div class="music-player__platforms">
        {% for platform in platforms %}
            <a href="{{ platform.url }}" target="{{ section_id }}" class="{{ platform.class }}{% if platform.active %} is-active{% endif %}" data-music-platform="{{ platform.index }}">{{ platform.text }}</a>
        {% endfor %}
    </div>

    {% for platform in platforms %}
        {% if platform.has_tracks %}
            <ol class="music-player__tracks" data-music-tracks="{{ platform.index }}"{% if not platform.active %} hidden{% endif %}>
                {% for track in platform.tracks %}
                    <li><a href="{{ track.url }}" target="{{ section_id }}">{{ track.title }}</a></li>
                {% endfor %}
            </ol>
        {% endif %}
    {% endfor %}

    <iframe name="{{ section_id }}"
            id="{{ section_id }}"
            class="music-iframe"
            style="border-radius:{{ iframe_border_radius }}"
            data-consent-src="{{ default_source }}"
            width="{{ player_width }}"
            height="{{ player_height }}"
            frameborder="0"
            allowfullscreen
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy">
    </iframe>
</div>
