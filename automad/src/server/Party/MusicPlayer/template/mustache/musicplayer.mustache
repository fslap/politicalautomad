<div class="wp-block-group widthcontainer music-player {{classes}}" data-party-music-player>
    {{#title}}<h1 class="wp-block-heading">{{title}}</h1>{{/title}}

    <div class="music-player__platforms">
        {{#platforms}}
            <a href="{{url}}" target="{{section_id}}" class="{{class}}{{#active}} is-active{{/active}}" data-music-platform="{{index}}">{{text}}</a>
        {{/platforms}}
    </div>

    {{#platforms}}
        {{#has_tracks}}
            <ol class="music-player__tracks" data-music-tracks="{{index}}"{{^active}} hidden{{/active}}>
                {{#tracks}}
                    <li><a href="{{url}}" target="{{section_id}}">{{title}}</a></li>
                {{/tracks}}
            </ol>
        {{/has_tracks}}
    {{/platforms}}

    <iframe name="{{section_id}}"
            id="{{section_id}}"
            class="music-iframe"
            style="border-radius:{{iframe_border_radius}}"
            src="{{default_source}}"
            width="{{player_width}}"
            height="{{player_height}}"
            frameborder="0"
            allowfullscreen
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy">
    </iframe>
</div>
