<div class="wp-block-group {{ classes }}">
    {% if section_id %}<a id="{{ section_id }}"></a>{% endif %}

    {% if title %}<h1 class="wp-block-heading section-heading">{{ title }}</h1>{% endif %}

    {% if description %}
        <p class="wp-block-paragraph">{{ description }}</p>
    {% endif %}

    {% if has_inner_container %}<div class="inner-container">{% endif %}

    <div class="viewbox-stack-container viewbox-info-{{ info_position }}">
        {% for image in images %}
            <input type="radio" name="viewbox-{{ section_id }}" id="{{ image.input_id }}" class="viewbox-radio" {{ image.checked ? 'checked' : '' }}>
        {% endfor %}

        <div class="image-stack">
            {% for image in images %}
                <div class="stack-item stack-item-{{ image.index }}" style="{{ image.style }}">
                    <label for="{{ image.input_id }}">
                        <img src="{{ image.file }}" class="stack-image" alt="{{ image.title }}">
                    </label>
                </div>
            {% endfor %}
        </div>

        <div class="info-block">
            {% for image in images %}
                <div class="info-item-{{ image.index }}">
                    <h3>{{ image.title }}</h3>
                    {% for line in image.lines %}<p>{{ line }}</p>{% endfor %}
                </div>
            {% endfor %}
        </div>
    </div>

    {% if has_inner_container %}</div>{% endif %}
</div>
