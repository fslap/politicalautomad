<div class="wp-block-group party-gallery {{classes}}">
    {{#section_id}}<a id="{{section_id}}"></a>{{/section_id}}
    {{#title}}<h1 class="wp-block-heading section-heading">{{title}}</h1>{{/title}}

    <div class="party-gallery__grid" style="--party-gallery-columns: {{columns}};">
        {{#images}}
            <figure class="wp-block-image party-gallery__item">
                <img src="{{src}}" alt="{{alt}}" loading="lazy">
                {{#caption}}<figcaption>{{caption}}</figcaption>{{/caption}}
            </figure>
        {{/images}}
    </div>
</div>
