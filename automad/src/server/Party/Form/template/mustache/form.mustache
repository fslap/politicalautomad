<div class="wp-block-group {{classes}}">
    {{#section_id}}<a id="{{section_id}}"></a>{{/section_id}}

    {{#title}}<h1 class="wp-block-heading section-heading">{{title}}</h1>{{/title}}

    {{#description}}
        <p class="wp-block-paragraph">{{description}}</p>
    {{/description}}

    {{#has_inner_container}}<div class="inner-container">{{/has_inner_container}}

    {{#status.success}}
        <p class="party-form__message party-form__message--success" role="status">{{status.message}}</p>
    {{/status.success}}
    {{#status.error}}
        <p class="party-form__message party-form__message--error" role="alert">{{status.message}}</p>
    {{/status.error}}

    {{^status.success}}
    <form method="{{form_method}}" {{#form_action}}action="{{form_action}}"{{/form_action}}{{^form_action}}action="#{{section_id}}"{{/form_action}} class="wp-block-form" data-party-form>
        <input type="hidden" name="form_section_id" value="{{section_id}}">
        <input type="text" name="nickname" value="" class="party-form__hp" tabindex="-1" autocomplete="off" aria-hidden="true">

        {{#fields}}
            <div class="wp-block-group form-field">
                {{^is_checkbox}}
                <label for="{{id}}" class="wp-block-label">
                    {{label}}
                    {{#required}}<span class="required">*</span>{{/required}}
                </label>
                {{/is_checkbox}}

                {{#is_textarea}}
                    <textarea name="{{name}}" id="{{id}}" class="wp-block-input wp-block-textarea" {{required_attr}}></textarea>
                {{/is_textarea}}

                {{#is_select}}
                    <select name="{{name}}" id="{{id}}" class="wp-block-select" {{required_attr}}>
                        <option value="">Bitte wählen …</option>
                        {{#options}}
                            <option value="{{.}}">{{.}}</option>
                        {{/options}}
                    </select>
                {{/is_select}}

                {{#is_checkbox}}
                    <label class="wp-block-label party-form__checkbox">
                        <input type="checkbox" name="{{name}}" id="{{id}}" value="ja" {{required_attr}}>
                        <span>{{label}}{{#required}} <span class="required">*</span>{{/required}}</span>
                    </label>
                {{/is_checkbox}}

                {{#is_input}}
                    <input type="{{type}}" name="{{name}}" id="{{id}}" class="wp-block-input" {{required_attr}}>
                {{/is_input}}
            </div>
        {{/fields}}

        {{#turnstile_site_key}}
        <div class="wp-block-group form-field">
            <label class="wp-block-label">Sicherheitsverifizierung:</label>
            <div class="cf-turnstile" data-sitekey="{{turnstile_site_key}}" data-theme="{{turnstile_theme}}"></div>
        </div>
        {{/turnstile_site_key}}

        <div class="wp-block-buttons">
            <div class="wp-block-button">
                <input type="submit" value="{{submit_label}}" class="wp-element-button">
            </div>
        </div>
    </form>
    {{/status.success}}

    {{#has_inner_container}}</div>{{/has_inner_container}}
</div>
