{{#has_rows}}
<div class="{{classes}}" style="{{style}}">
    {{#section_id}}<a id="{{section_id}}"></a>{{/section_id}}
    {{#rows}}
        <div class="panel-strip__row">
            {{#panels}}
                <figure class="panel-strip__panel party-hover-item" style="{{style}}">
                    {{#link}}<a href="{{link}}">{{/link}}
                        {{#image}}<img src="{{image}}" alt="{{alt}}" decoding="async">{{/image}}{{^image}}<span class="panel-strip__empty" aria-hidden="true"></span>{{/image}}
                        {{#caption}}<figcaption>{{caption}}</figcaption>{{/caption}}
                    {{#link}}</a>{{/link}}
                </figure>
            {{/panels}}
        </div>
    {{/rows}}
</div>
{{/has_rows}}
