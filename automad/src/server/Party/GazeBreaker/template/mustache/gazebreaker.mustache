<div class="gaze-breaker {{classes}} {{hover_classes}}{{#dividers}} gaze-breaker--dividers{{/dividers}}" style="{{style}}"{{#hover_look}} data-party-look{{/hover_look}}>
    {{#section_id}}<a id="{{section_id}}"></a>{{/section_id}}
    <div class="gaze-breaker__grid">
        {{#columns}}<span class="gaze-breaker__column" style="{{style}}" aria-hidden="true"></span>{{/columns}}
        {{#items}}
            <div class="gaze-breaker__item party-hover-item {{classes}}" style="{{style}} --depth: {{depth}};">
                {{#link}}<a href="{{link}}">{{/link}}
                    <img src="{{image}}" alt="{{alt}}" decoding="async">
                {{#link}}</a>{{/link}}
            </div>
        {{/items}}
    </div>
</div>
