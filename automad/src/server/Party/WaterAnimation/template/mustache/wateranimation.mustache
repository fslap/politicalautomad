<div class="wp-block-group party-svg-scene {{classes}} {{hover_classes}}{{#hide_mobile}} party-hide-mobile{{/hide_mobile}}" style="{{scene_style}}"{{#hover_look}} data-party-look{{/hover_look}}>
    <div class="party-svg-canvas" style="{{canvas_style}}">
        {{#layers}}
            <div class="party-svg-layer {{position}}">
                {{#svgs}}
                    <img src="{{file}}" class="svg {{animation_class}}" style="z-index: {{z}}; {{shift}}" alt="" title="{{title}}" decoding="async">
                {{/svgs}}
            </div>
        {{/layers}}
    </div>
</div>
