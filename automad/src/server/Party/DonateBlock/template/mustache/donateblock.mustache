<div class="donate-block" data-component="donateblock">
  <h2>{{ title }}</h2>
  <p class="message">{{ message }}</p>

  <div class="amount-buttons">
    {{#amounts}}
    <button class="amount-btn" data-amount="{{ . }}">€{{ . }}</button>
    {{/amounts}}
  </div>

  <a href="#donate-form" class="btn btn-primary btn-large">Donate Now</a>
  <p class="secure">Secure &amp; encrypted donation</p>
</div>