{% if warning_text %}
    <div class="party-header__bar {{ classes }}" role="note">
        <p>{{ warning_text }}</p>
    </div>
{% endif %}

<div class="party-header__title">
    {% for part in party_name_parts %}
        <h1 class="wp-block-heading party-header__line">{{ part }}</h1>
    {% endfor %}
</div>

<div class="wp-block-group party-header__cta">
    {% if main_link %}<a href="{{ main_link }}" target="_blank" rel="noopener" class="wp-element-button">{{ main_link_text ?: main_link }}</a>{% endif %}
    {% if intro_text %}<p class="wp-block-paragraph">{{ intro_text }}</p>{% endif %}
</div>
