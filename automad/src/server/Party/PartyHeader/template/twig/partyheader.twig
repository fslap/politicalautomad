<div class="wp-block-group {{ classes }}" style="text-align: center;">
    {% if warning_text %}
        <p class="wp-block-paragraph">{{ warning_text }}</p>
    {% endif %}
</div>

<div class="party-header__title">
    {% for part in party_name_parts %}
        <h1 class="wp-block-heading party-header__line">{{ part }}</h1>
    {% endfor %}
</div>

<br><br>

<div class="wp-block-group party-header__cta">
    <a href="{{ main_link }}" target="_blank" class="wp-element-button">
        {{ main_link_text }}
    </a>
    <br><br>
    <p class="wp-block-paragraph">{{ intro_text }}</p>
</div>
