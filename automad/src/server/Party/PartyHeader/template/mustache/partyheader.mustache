{{#warning_text}}
    <div class="party-header__bar {{classes}}" role="note">
        <p>{{warning_text}}</p>
    </div>
{{/warning_text}}

<div class="party-header__title">
    {{#party_name_parts}}
        <h1 class="wp-block-heading party-header__line">{{.}}</h1>
    {{/party_name_parts}}
</div>

<div class="wp-block-group party-header__cta">
    {{#main_link}}<a href="{{main_link}}" target="_blank" rel="noopener" class="wp-element-button">{{main_link_text}}{{^main_link_text}}{{main_link}}{{/main_link_text}}</a>{{/main_link}}
    {{#intro_text}}<p class="wp-block-paragraph">{{intro_text}}</p>{{/intro_text}}
</div>
