<div class="wp-block-group party-concept {{classes}}">
    {{#section_id}}<a id="{{section_id}}"></a>{{/section_id}}

    <div class="party-concept__grid{{^image}} party-concept__grid--text{{/image}}">
        {{#image}}
            <figure class="party-concept__media">
                <picture>
                    {{#mobile_image}}<source media="(max-width: 800px)" srcset="{{mobile_image}}">{{/mobile_image}}
                    <img src="{{image}}" alt="{{title}}" decoding="async">
                </picture>
            </figure>
        {{/image}}

        <div class="party-concept__body">
            {{#title}}<h2 class="wp-block-heading party-concept__title">{{title}}</h2>{{/title}}
            {{#subtitle_html}}<p class="party-concept__subtitle"><span>{{{subtitle_html}}}</span></p>{{/subtitle_html}}
            {{#subtitle_emphasis_html}}<p class="party-concept__emphasis">{{{subtitle_emphasis_html}}}</p>{{/subtitle_emphasis_html}}

            {{#has_features}}
                <ul class="party-concept__features" data-prefix="{{feature_prefix}}">
                    {{#features}}<li>{{.}}</li>{{/features}}
                </ul>
            {{/has_features}}
        </div>
    </div>
</div>
