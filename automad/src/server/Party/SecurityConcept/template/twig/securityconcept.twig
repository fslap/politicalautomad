<div class="wp-block-group party-concept {{ classes }}">
    {% if section_id %}<a id="{{ section_id }}"></a>{% endif %}

    <div class="party-concept__grid{% if not image %} party-concept__grid--text{% endif %}">
        {% if image %}
            <figure class="party-concept__media">
                <picture>
                    {% if mobile_image %}<source media="(max-width: 800px)" srcset="{{ mobile_image }} 1x">{% endif %}
                    <img src="{{ image }}" alt="{{ title }}" decoding="async">
                </picture>
            </figure>
        {% endif %}

        <div class="party-concept__body">
            {% if title %}<h2 class="wp-block-heading party-concept__title">{{ title }}</h2>{% endif %}
            {% if subtitle_html %}<p class="party-concept__subtitle"><span>{{ subtitle_html|raw }}</span></p>{% endif %}
            {% if subtitle_emphasis_html %}<p class="party-concept__emphasis">{{ subtitle_emphasis_html|raw }}</p>{% endif %}

            {% if has_features %}
                <ul class="party-concept__features" data-prefix="{{ feature_prefix }}">
                    {% for feature in features %}<li>{{ feature }}</li>{% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
</div>
