<div class="glass-front glass-front--text-{{position}} {{#glow}}glass-front--glow{{/glow}} {{classes}}" style="{{style}}">
    {{#section_id}}<a id="{{section_id}}"></a>{{/section_id}}
    <div class="glass-front__front">{{{svg}}}</div>

    {{#has_content}}
        <div class="glass-front__content">
            {{#title}}<h2 class="glass-front__title">{{title}}</h2>{{/title}}
            {{#text_html}}<div class="glass-front__text">{{{text_html}}}</div>{{/text_html}}
            {{#has_items}}
                <ul class="glass-front__items">
                    {{#items}}<li>{{#lead}}<strong>{{lead}}:</strong> {{/lead}}{{text}}</li>{{/items}}
                </ul>
            {{/has_items}}
        </div>
    {{/has_content}}
</div>
