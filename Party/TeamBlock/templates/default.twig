{# Self-contained #}
<div class="team-block" data-component="teamblock">
  <h2>{{ title }}</h2>
  <div class="team-grid">
    {% for member in members %}
    <div class="team-member">
      {% if member.image %}<img src="{{ member.image }}" alt="{{ member.name }}" class="member-photo">{% endif %}
      <h3>{{ member.name }}</h3>
      <p class="role">{{ member.role }}</p>
      <p class="bio">{{ member.bio }}</p>
    </div>
    {% endfor %}
  </div>
</div>