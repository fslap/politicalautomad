{
	"permissions": {
		"allow": [
			"Bash",
			"Edit",
			"Write",
			"Read",
			"Glob",
			"Grep"
		],
		"deny": [
			"Read(.env)",
			"Read(.env.*)",
			"Read(config/*.php)"
		],
		"defaultMode": "acceptEdits",
		"blockReadsOutsideWorkingDirectories": false
	},
	"sandbox": {
		"enabled": false,
		"failIfUnavailable": false,
		"filesystem": {
			"denyRead": [".env", ".env.*", "./config/*.php"]
		}
	}
}
